<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleExecutable</key>
	<string>qingjian-macos</string>
	<key>CFBundleIdentifier</key>
	<string>app.qingjian.inputmethod</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Qingjian</string>
	<key>CFBundleDisplayName</key>
	<string>青简</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconFile</key>
	<string>Qingjian</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<!-- 原本写 13.0，但代码里没有任何 macos(13.x) 可用性标注、二进制的部署目标也是 10.12，
	     这个下限只是声明。写 13.0 会让 macOS 12 直接拒绝启动（kLSIncompatibleSystemVersionErr），
	     选它时进程起不来、系统退化成裸键盘输入，看起来就是「只能输入英文」。 -->
	<string>12.0</string>
	<!-- 原本写的是 LSBackgroundOnly（纯后台应用），但青简要建菜单栏状态项与候选窗 NSPanel，
	     那是后台应用不允许的：NSStatusBar statusItemWithLength 会在 AppKit 里 NSCGSPanic，
	     进程一起来就挂，于是选它时系统报「键盘布局不可用」、候选窗也不出。
	     LSUIElement 才是对的语义：不显示 Dock 图标，但可以有自己的界面。 -->
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- InputMethodKit：连接名按 10.7 起的约定必须是 <bundle id>_Connection -->
	<key>InputMethodConnectionName</key>
	<string>app.qingjian.inputmethod_Connection</string>
	<!-- 与 imk/controller/mod.rs 里 define_class! 的 #[name] 一致 -->
	<key>InputMethodServerControllerClass</key>
	<string>QingjianInputController</string>
	<key>InputMethodType</key>
	<string>Keyboard</string>

	<!-- Text Input Sources：系统「输入法」列表里的身份 -->
	<key>TISInputSourceID</key>
	<string>app.qingjian.inputmethod</string>
	<key>TISIntendedLanguage</key>
	<string>zh-Hans</string>
	<!-- 允许系统设置里打开「用 Caps Lock 在 ABC 与青简之间切换」；缺省不开，青简自己的 Caps Lock 英文模式不变（#211）。
		另外要求字符集不含 Latn：带着它系统会把青简归成拉丁类输入源，这个设置项根本不出现在系统设置里（鼠须管 1.0.1 同款坑） -->
	<key>TICapsLockLanguageSwitchCapable</key>
	<true/>
	<key>tsInputMethodIconFileKey</key>
	<string>qingjian-menu.pdf</string>
	<!-- 模板图：系统只取 alpha，按深浅色自动反色 -->
	<key>TISIconIsTemplate</key>
	<true/>
	<!-- 只声明汉字：多一个 Latn 都会被系统按拉丁类输入源处理，见上面 Caps Lock 切换的说明 -->
	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
	</array>

	<!-- 输入模式：系统登记、启用的是模式 app.qingjian.inputmethod.Hans，顶层 ID 是它的父项；
	显示名在 InfoPlist.strings 按模式 ID 给。约定见 docs/design/architecture.md「Info.plist 约定」 -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>app.qingjian.inputmethod.Hans</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>app.qingjian.inputmethod.Hans</string>
				<key>TISIntendedLanguage</key>
				<string>zh-Hans</string>
				<key>tsInputModeCharacterRepertoireKey</key>
				<array>
					<string>Hans</string>
				</array>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModeMenuIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>qingjian-menu.pdf</string>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<key>tsInputModeScriptKey</key>
				<string>smUnicodeScript</string>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>app.qingjian.inputmethod.Hans</string>
		</array>
	</dict>
</dict>
</plist>
